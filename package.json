{
  "name": "pi-ed",
  "version": "0.1.0",
  "private": true,
  "description": "Ed's Pi extensions: autopilot, loop guard, compaction summary guard, SearXNG web search, queue-reload, session commands, session markers and hashtags",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Ed Beech",
  "engines": {
    "node": ">=22.6"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.10.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initialed85/pi-ed.git"
  },
  "homepage": "https://github.com/initialed85/pi-ed#readme"
}
